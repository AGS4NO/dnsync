$ORIGIN zonefile.dnsync.net.
$TTL 3600

; BIND zone file — manages zonefile.dnsync.net (separate from dns.yaml which manages dnsync.net)

; A record
bind-test       IN  A       198.51.100.10

; AAAA record
bind-test       IN  AAAA    2001:db8::10

; CNAME record
www-bind-test   IN  CNAME   bind-test.zonefile.dnsync.net.

; MX record
bind-test       IN  MX  10  mail1.zonefile.dnsync.net.

; TXT record
bind-test       IN  TXT     "dnsync-bind-managed-record"
